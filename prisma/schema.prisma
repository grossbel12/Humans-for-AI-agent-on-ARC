generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  Open
  InProgress
  ProofSubmitted
  Completed
  Disputed
  Cancelled
  AutoReleased
}

model User {
  id        String   @id @default(cuid())
  address   String   @unique
  nonce     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   HumanProfile?
  tasksMade Task[]   @relation("EmployerTasks")
  tasksWork Task[]   @relation("ExecutorTasks")
}

model HumanProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  address     String   @unique
  name        String
  headline    String
  bio         String
  city        String
  country     String
  remote      Boolean  @default(false)
  skills      String[]
  categories  String[]
  rateUsd     Decimal  @db.Decimal(12, 2)
  rating      Decimal  @default(0) @db.Decimal(3, 2)
  reputation  Int      @default(0)
  jobsDone    Int      @default(0)
  verified    Boolean  @default(false)
  available   Boolean  @default(true)
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id              String     @id @default(cuid())
  chainTaskId     String?
  contractAddress String?
  txHash          String?
  title           String
  description     String
  category        String
  location        String?
  amountUsdc      Decimal    @db.Decimal(18, 6)
  amountAtomic    String
  deadline        DateTime
  status          TaskStatus @default(Open)
  metadataHash    String
  proofHash       String?
  proofUrl        String?
  employerAddress String
  executorAddress String
  agentId         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?
  employer        User       @relation("EmployerTasks", fields: [employerAddress], references: [address])
  executor        User       @relation("ExecutorTasks", fields: [executorAddress], references: [address])
  receipts        PaymentReceipt[]
}

model PaymentReceipt {
  id          String   @id @default(cuid())
  paymentId   String?  @unique
  taskId      String?
  route       String
  amount      String
  network     String
  payer       String?
  txHash      String?
  raw         Json?
  createdAt   DateTime @default(now())
  task        Task?    @relation(fields: [taskId], references: [id])
}
